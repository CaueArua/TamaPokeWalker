// TamaPoke is a first-generation-inspired pixel-art virtual pet
// for the Waveshare ESP32-S3-Touch-AMOLED-1.75.
//
// Libraries (Arduino Library Manager or Waveshare repository):
//   - "GFX Library for Arduino" (moononournation), with CO5300 QSPI support
//   - "SensorLib" (Lewis He), for the CST9217 touch controller
//
// Board: ESP32S3 Dev Module | 16 MB Flash | OPI PSRAM | USB CDC On Boot: Enabled
//
// Sprites and the species table are generated by tools/sprites.py (emit).

#include <Arduino.h>
#include "Arduino_GFX_Library.h"
#include "pin_config.h"
#include "species.h"
#include "dex.h"
#include "pet.h"
#include "sdmon.h"
#include "src/ui/main_screen.h"
#include "src/ui/screen_controller.h"
#include "src/app_controller.h"
#include "src/startup.h"

// Firmware version. Increment this for each release and update manifest.json
// for the web installer. It is shown in Settings and printed at startup.
#if defined(TAMAPOKE_LOCAL_TEST) && defined(TAMAPOKE_GEN3_RELEASE)
#error "TAMAPOKE_LOCAL_TEST and TAMAPOKE_GEN3_RELEASE are mutually exclusive"
#endif
#if DEX_COUNT > 251 && !defined(TAMAPOKE_LOCAL_TEST) && !defined(TAMAPOKE_GEN3_RELEASE)
#error "Gen-3 source requires an explicit local-test or release build profile"
#endif
#ifdef TAMAPOKE_LOCAL_TEST
#define FW_VERSION "1.36.2-hoenn-walk-local"
#elif defined(TAMAPOKE_GEN3_RELEASE)
#define FW_VERSION "1.36.2"
#else
#define FW_VERSION "1.35.3-soft-step"
#endif

/**
 * Returns the firmware version selected by the active build profile.
 *
 * @return The version string defined by FW_VERSION.
 */
const char *firmwareVersion() { return FW_VERSION; }

Arduino_DataBus *bus = new Arduino_ESP32QSPI(
  LCD_CS, LCD_SCLK, LCD_SDIO0, LCD_SDIO1, LCD_SDIO2, LCD_SDIO3);
Arduino_CO5300 *panel = new Arduino_CO5300(
  bus, LCD_RESET, 0 /*rotation*/, LCD_WIDTH, LCD_HEIGHT, 6, 0, 0, 0);
// The full framebuffer lives in PSRAM; render complete frames before flushing.
Arduino_Canvas *gfx = new Arduino_Canvas(LCD_WIDTH, LCD_HEIGHT, panel);

Pet pet;

// Animated sprite assets for the current species, when available on the SD card.
SdMon mon;          // Monochrome fallback sprite, also used by minigames.
PmdMon pmd;         // Main-screen PMD sprite with multiple actions.
PmdMon evoPmd;      // Previous form, shown only during the evolution flash.

// Main-pet animation state.
PetBehavior beh;

// Shared screen and application state.
bool uiDirty = true;

uint32_t lastRender = 0;
uint32_t perfRenderLastMs = 0, perfRenderMaxMs = 0;
uint32_t perfLoopLastMs = 0, perfLoopMaxMs = 0;
uint32_t perfRenderCount = 0, perfRenderSkipCount = 0;
// AMOLED protection and touch-gesture state.
/**
 * Marks the current UI view for redraw.
 */
void markUiDirty() {
  uiDirty = true;
  if (activeScreen) activeScreen->markDirty();
  else if (gameMenuOpen) gameMenuDirty = true;
}

/**
 * Initializes hardware, sensors, and the application in dependency order.
 */
void setup() {
  initializeHardware();
  initializeSensors();
  initializeProgram();
}

void loop() {
  runAppLoop();
}
