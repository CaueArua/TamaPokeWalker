/**
 * Loads the persisted power-saving preference from NVS.
 */
void loadPowerSave() {
  Preferences p;
  p.begin("tamapoke", true);
  powerSave = p.getBool("psave", false);
  p.end();
}

/**
 * Updates and persists the power-saving preference.
 *
 * @param on Whether power-saving mode should be enabled.
 */
void setPowerSave(bool on) {
  powerSave = on;
  Preferences p;
  p.begin("tamapoke", false);
  p.putBool("psave", powerSave);
  p.end();
}

