/**
 * Routes vertical swipes to the active screen or opens the clock/card from home.
 *
 * @param dir Positive for a downward swipe, negative for an upward swipe.
 */
void onSwipeV(int dir) {
  if (pet.awaitingStarter()) return;  // Ignore input while choosing a starter.
  if (wildPromptUntil && deadlineActive(millis(), wildPromptUntil)) return;
  if (wildPromptUntil) wildPromptUntil = 0;
  if (gameMenuOpen) return;
  if (pet.ceremony) return;
  if (activeScreen) {
    activeScreen->handleSwipeV(dir);
    return;
  }

  mainScreen.handleSwipeV(dir);
}

/**
 * Routes horizontal swipes to the active screen or opens the Dex/party from home.
 *
 * @param dir Negative for left; positive for right.
 */
void onSwipe(int dir) {
  if (pet.awaitingStarter()) return;  // Ignore input while choosing a starter.
  if (wildPromptUntil && deadlineActive(millis(), wildPromptUntil)) return;
  if (wildPromptUntil) wildPromptUntil = 0;
  if (gameMenuOpen) return;
  if (activeScreen) {
    activeScreen->handleSwipe(dir);
    return;
  }
  mainScreen.handleSwipe(dir);
}

/**
 * Sends taps to the active screen, falling back to the main screen when none is active.
 *
 * @param x Horizontal display coordinate.
 * @param y Vertical display coordinate.
 */
void onTap(int16_t x, int16_t y) {
  // Serial.printf("TOUCH %d %d\n", x, y);  // Disabled because it floods the serial log.
  if (activeScreen) {
    Screen *tappedScreen = activeScreen;
    activeScreen->handleTap(x, y);
    if (activeScreen == tappedScreen && tappedScreen->shouldClose())
      setScreen(nullptr);
    return;
  }
  mainScreen.handleTap(x, y);
}

// Shared rendering utilities and screen dispatch.

bool gNight = false;  // Set by render() from local time or pet sleep state.
/**
 * Returns the foreground ink color for the current day/night scene.
 *
 * @return The active UI ink color.
 */
uint16_t inkColor() { return gNight ? UI_INK_NIGHT : UI_INK; }

// Background-scene rendering based on biome and real-time clock.

#define C565(r, g, b) ((uint16_t)((((r) >> 3) << 11) | (((g) >> 2) << 5) | ((b) >> 3)))
#define HORIZON 232  // Boundary between the sky and ground.

/**
 * Interpolates between two RGB565 colors.
 *
 * @param a Starting color.
 * @param b Ending color.
 * @param i Current interpolation step.
 * @param n Total interpolation steps.
 * @return The interpolated RGB565 color.
 */
uint16_t lerp565(uint16_t a, uint16_t b, int i, int n) {
  if (n <= 0) return a;
  int ar = (a >> 11) & 31, ag = (a >> 5) & 63, ab = a & 31;
  int br = (b >> 11) & 31, bg = (b >> 5) & 63, bb = b & 31;
  return (uint16_t)((((ar + (br - ar) * i / n) << 11)) |
                    (((ag + (bg - ag) * i / n) << 5)) | (ab + (bb - ab) * i / n));
}

/**
 * Selects the watermark corner, rotating every 20 seconds.
 *
 * @return The current corner index.
 */
static uint8_t watermarkSlot() {
  return (uint8_t)((millis() / 20000UL) & 3U);
}

/**
 * Indicates whether the watermark has moved to a new corner and needs redrawing.
 *
 * @return True when the current frame should be refreshed.
 */
bool watermarkNeedsRedraw() {
  return !screenOff && watermarkDrawnSlot != (int8_t)watermarkSlot();
}

/**
 * Blends a watermark tint into a pixel while preserving contrast.
 *
 * @param base Original RGB565 pixel color.
 * @return The tinted RGB565 color.
 */
static uint16_t watermarkPixel(uint16_t base) {
  int r = ((base >> 11) & 31) * 255 / 31;
  int g = ((base >> 5) & 63) * 255 / 63;
  int b = (base & 31) * 255 / 31;
  int luminance = (r * 30 + g * 59 + b * 11) / 100;
  return lerp565(base, luminance > 145 ? 0x0000 : 0xFFFF, 1, 4);
}

/**
 * Draws the small watermark glyphs into the current framebuffer slot.
 *
 * @param slot Watermark corner index.
 */
static void drawWatermark(uint8_t slot) {
  static const uint8_t GLYPHS[3][7] = {
    { 0x0E, 0x11, 0x17, 0x15, 0x17, 0x10, 0x0E },  // @
    { 0x1F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E },  // S
    { 0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F },  // E
  };
  static const int16_t POS[4][2] = {
    { 74, 74 }, { 374, 74 }, { 74, 384 }, { 374, 384 },
  };
  uint16_t *fb = gfx->getFramebuffer();
  if (!fb) return;
  int16_t ox = POS[slot][0];
  int16_t oy = POS[slot][1];
  for (uint8_t glyph = 0; glyph < 3; glyph++) {
    for (uint8_t row = 0; row < 7; row++) {
      uint8_t bits = GLYPHS[glyph][row];
      for (uint8_t col = 0; col < 5; col++) {
        if (!(bits & (1U << (4 - col)))) continue;
        int16_t x = ox + glyph * 6 + col;
        int16_t y = oy + row;
        if (x < 0 || x >= LCD_WIDTH || y < 0 || y >= LCD_HEIGHT) continue;
        uint32_t idx = (uint32_t)y * LCD_WIDTH + x;
        fb[idx] = watermarkPixel(fb[idx]);
      }
    }
  }
}

/**
 * Stamps the current frame with a watermark and submits it to the display.
 */
void flushStampedFrame() {
  uint8_t slot = watermarkSlot();
  drawWatermark(slot);
  watermarkDrawnSlot = (int8_t)slot;
  gfx->flush();
}

/**
 * Returns the pet's current local-scene hour derived from its synchronized clock.
 *
 * @return Hour of day in the range 0-23.
 */
int sceneHour() {
  return sceneHourFromEpoch(pet.lastSeenEpoch);
}

/**
 * Maps the current scene hour to a day-phase category.
 *
 * @return The phase identifier consumed by encounter and UI logic.
 */
uint8_t currentDayPhase() {
  return dayPhaseFromHour(sceneHour());
}

/**
 * Maps a day-phase identifier to its localized text resource.
 *
 * @param phase Day-phase identifier.
 * @return The matching localization string identifier.
 */
StrId dayPhaseTextId(uint8_t phase) {
  switch (phase) {
    case 0: return S_MORNING;
    case 2: return S_EVENING;
    case 3: return S_NIGHT;
    default: return S_DAY;
  }
}

// Daytime ground colors for each biome; night scenes blend them toward blue.
const uint16_t BIOME_SOIL[6] = {
  C565(0x7e, 0xc0, 0x7f),  // 0 meadow
  C565(0xdc, 0xca, 0x94),  // 1 beach
  C565(0x4f, 0x8a, 0x55),  // 2 forest
  C565(0x8a, 0x55, 0x44),  // 3 volcano
  C565(0xa8, 0x90, 0x6a),  // 4 mountain
  C565(0xe6, 0xee, 0xf5),  // 5 snow
};
/**
 * Renders the active screen, or the main screen when no modular screen is active.
 */
void render() {
  if (watermarkNeedsRedraw()) {
    cardDirty = true;
    clockDirty = true;
    helpDirty = true;
    keyboardDirty = true;
    gameMenuDirty = true;
    battleScreen.markDirty();
    if (activeScreen) activeScreen->markDirty();
  }
  if (staticScreenClean()) { perfRenderSkipCount++; return; }
  if (activeScreen) {
    Screen *renderingScreen = activeScreen;
    renderingScreen->render();
    if (activeScreen == renderingScreen && renderingScreen->shouldClose())
      setScreen(nullptr);
    return;
  }
  mainScreen.render();
}

// Shared minigame background renderer.
void drawGameScene();  // Forward declaration; implementation follows.

/**
 * Draws the shared minigame background using the current hour and pet biome.
 */
void drawGameScene() {
  int hh = sceneHour();
  bool night = hh < 6 || hh >= 20;
  uint16_t top, bot;
  if (night)       { top = C565(0x0c, 0x12, 0x24); bot = C565(0x1e, 0x26, 0x46); }
  else if (hh < 8) { top = C565(0xd1, 0x6a, 0x86); bot = C565(0xf3, 0xb8, 0x7c); }
  else if (hh < 18){ top = C565(0x8f, 0xc8, 0xea); bot = C565(0xdc, 0xee, 0xe6); }
  else             { top = C565(0xc7, 0x5a, 0x4a); bot = C565(0xf0, 0xae, 0x64); }
  int hor = 376;
  for (int y = 0; y < hor; y += 8)
    gfx->fillRect(0, y, 466, 8, lerp565(top, bot, y, hor));
  if (night)
    for (auto &st : STARS) gfx->fillRect(st[0], st[1], 4, 4, UI_WHITE);
  uint8_t bio = pet.isEgg() ? 0 : DEX_TBL[pet.speciesId].biome;
  uint16_t soil = BIOME_SOIL[bio < 6 ? bio : 0];
  if (night) soil = lerp565(soil, C565(0x16, 0x1c, 0x30), 9, 16);
  gfx->fillRect(0, hor, 466, 466 - hor, soil);
}

/**
 * Opens time settings initialized from the pet's current clock.
 *
 * The entered time is treated as local wall-clock time; no timezone conversion
 * is applied, and the settings screen preserves the current calendar day.
 */
void openClock(Screen *returnTo) {
  uint32_t e = pet.lastSeenEpoch ? pet.lastSeenEpoch : rtcEpoch();
  clockH = (e / 3600) % 24;
  clockM = (e / 60) % 60;
  clockDirty = true;
  clockSettingsScreen.setReturnScreen(returnTo);
  setScreen(&clockSettingsScreen);
  sfxPlay(SFX_MENU);
}

/**
 * Opens the help screen at its first page.
 */
void openHelp() {
  helpPage = 0;
  helpDirty = true;
  setScreen(&helpScreen);
  sfxPlay(SFX_MENU);
}

/**
 * Opens the rename keyboard and copies the current pet name into its edit buffer.
 */
void openKeyboard(Screen *returnTo) {
  keyboardDirty = true;
  keyboardScreen.setReturnScreen(returnTo);
  setScreen(&keyboardScreen);
  strncpy(nameBuf, pet.nick, sizeof(nameBuf) - 1);
  nameBuf[sizeof(nameBuf) - 1] = 0;
  nameLen = strlen(nameBuf);
  sfxPlay(SFX_MENU);
}

#define GAL_X 73
#define GAL_Y 116
#define GAL_CELL 74

/**
 * Draws a sprite thumbnail centered in a gallery cell.
 *
 * @param b Encoded sprite data containing dimensions, palette, and pixels.
 * @param x Left edge of the gallery cell.
 * @param y Top edge of the gallery cell.
 * @param s Integer pixel scale.
 * @param sil Whether to render the sprite as a solid silhouette.
 */
void drawThumb(const uint8_t *b, int x, int y, int s, bool sil) {
  uint8_t w = b[0], h = b[1], n = b[2];
  const uint8_t *pal = b + 3;
  const uint8_t *d = pal + n * 2;
  int ox = x + (GAL_CELL - w * s) / 2;
  int oy = y + (GAL_CELL - h * s) / 2;
  for (int r = 0; r < h; r++) {
    for (int c = 0; c < w; c++) {
      uint8_t idx = d[r * w + c];
      if (idx == 0xFF) continue;
      uint16_t col = sil ? INK_K : (uint16_t)(pal[idx * 2] | (pal[idx * 2 + 1] << 8));
      gfx->fillRect(ox + c * s, oy + r * s, s, s, col);
    }
  }
}





// PMD animation timing and drawing helpers.

/**
 * Sums the frame durations for one PMD action.
 *
 * @param a PMD action whose frame durations should be summed.
 * @return Total duration in milliseconds, or 100 ms when no duration is defined.
 */
uint32_t pmdActTotalMs(const PmdAct &a) {
  uint32_t t = 0;
  for (uint8_t i = 0; i < a.frames; i++) t += a.ms[i];
  return t ? t : 100;
}

/**
 * Selects the animation frame for an elapsed time, either looping or clamping at the end.
 *
 * @param a PMD action to sample.
 * @param t Elapsed animation time in milliseconds.
 * @param loop Whether the action should repeat after its final frame.
 * @return Frame index for the requested time.
 */
uint8_t pmdFrameAt(const PmdAct &a, uint32_t t, bool loop) {
  uint32_t total = pmdActTotalMs(a);
  if (!loop && t >= total) return a.frames - 1;
  t %= total;
  uint8_t i = 0;
  while (t >= a.ms[i]) {
    t -= a.ms[i];
    i = (i + 1) % a.frames;
  }
  return i;
}

/**
 * Draws a frame from a specific PMD animation, anchored to its ground baseline.
 *
 * @param m PMD sprite and animation data to render.
 * @param actId Action identifier in the PMD animation table.
 * @param cx Horizontal center of the sprite.
 * @param groundY Vertical ground baseline.
 * @param t Elapsed animation time in milliseconds.
 * @param loop Whether the action should loop.
 * @param sil Whether to render the sprite as a silhouette.
 * @param maxS Maximum integer scale allowed for the sprite.
 */
void drawPmdActM(PmdMon &m, uint8_t actId, int cx, int groundY, uint32_t t, bool loop, bool sil, uint8_t maxS) {
  const PmdAct &a = m.acts[actId];
  if (!a.frames) return;
  uint8_t sBase = m.acts[PMD_IDLE].h ? 170 / m.acts[PMD_IDLE].h : 5;
  if (sBase < 2) sBase = 2;
  if (sBase > maxS) sBase = maxS;
  uint8_t s = sBase;
  while (s > 2 && a.h * s > 250) s--;  // Reduce oversized frames, such as attacks.
  uint8_t fi = pmdFrameAt(a, t, loop);
  const uint8_t *fr = a.data + (uint32_t)fi * a.w * a.h;
  // Anchor by the feet (a.base), not the full canvas height, so actions with
  // different padding (such as Hurt or Eat) share the same ground baseline.
  int x0 = cx - a.w * s / 2, y0 = groundY - (a.base ? a.base : a.h) * s;
  for (int r = 0; r < a.h; r++) {
    const uint8_t *row = fr + r * a.w;
    for (int c = 0; c < a.w; c++) {
      uint8_t idx = row[c];
      if (idx == 0xFF) continue;
      gfx->fillRect(x0 + c * s, y0 + r * s, s, s, sil ? INK_K : m.pal[idx]);
    }
  }
}
/**
 * Draws an action from the current pet's global PMD sprite.
 *
 * @param actId Action identifier in the PMD animation table.
 * @param cx Horizontal center of the sprite.
 * @param groundY Vertical ground baseline.
 * @param t Elapsed animation time in milliseconds.
 * @param loop Whether the action should loop.
 * @param sil Whether to render the sprite as a silhouette.
 * @param maxS Maximum integer scale allowed for the sprite.
 */
void drawPmdAct(uint8_t actId, int cx, int groundY, uint32_t t, bool loop, bool sil, uint8_t maxS) {
  drawPmdActM(pmd, actId, cx, groundY, t, loop, sil, maxS);
}

/**
 * Draws an n-by-n character map at an integer scale.
 *
 * @param map Character map whose non-period characters select sprite colors.
 * @param n Width and height of the square map.
 * @param x Left edge of the rendered map.
 * @param y Top edge of the rendered map.
 * @param s Integer pixel scale.
 * @param silhouette Whether to render every visible pixel in the ink color.
 */
void drawMap(const char *const *map, int n, int x, int y, int s, bool silhouette) {
  for (int r = 0; r < n; r++) {
    for (int c = 0; c < n; c++) {
      char ch = map[r][c];
      if (ch == '.') continue;
      gfx->fillRect(x + c * s, y + r * s, s, s, silhouette ? INK_K : spriteColor(ch));
    }
  }
}
